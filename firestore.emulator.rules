rules_version = '2';

// Emulator-only ruleset — never deployed to the real Firestore project.
// Permissive by design: e2e tests sign in via the Auth Emulator's test-only
// anonymous path (see src/services/firebase.ts), so there is no real user
// identity here to scope rules to.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
